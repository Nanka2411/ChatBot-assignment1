<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="900"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- ASCII -->
            <RowDefinition Height="*"/>
            <!-- Chat -->
            <RowDefinition Height="Auto"/>
            <!-- Input -->
        </Grid.RowDefinitions>

        <!-- ================= TITLE ================= -->
        <TextBlock Grid.Row="0"
                   Text="Cybersecurity Awareness Chatbot"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="DeepSkyBlue"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- ================= ASCII ART IMAGE  ================= -->
        <Image Grid.Row="1"
               Source="/Image/cyberpal_logo.jpeg"
               Height="120"
               HorizontalAlignment="Center"/>

        <!-- ================= CHAT AREA ================= -->
        <RichTextBox Grid.Row="2"
                     Name="ChatBox"
                     Margin="0,10"
                     IsReadOnly="True"
                     FontSize="14"
                     Background="#000000"
                     Foreground="Lime"
                     BorderBrush="Cyan"
                     VerticalScrollBarVisibility="Auto"/>

        <!-- ================= INPUT AREA ================= -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,10">

            <TextBox Name="UserInput"
                     Width="700"
                     Height="40"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Background="White"
                     Foreground="Black"
                     Margin="0,0,10,0"/>

            <Button Content="Send"
                    Width="150"
                    Height="40"
                    Background="Cyan"
                    Foreground="Black"
                    FontWeight="Bold"
                    Click="SendButton_Click"/>
        </StackPanel>

    </Grid>
</Window>