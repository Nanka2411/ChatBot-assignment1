<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="900"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Image -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
            <RowDefinition Height="*"/>
            <!-- Chat -->
            <RowDefinition Height="Auto"/>
            <!-- Input -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="Cybersecurity Awareness Chatbot"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="DeepSkyBlue"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- IMAGE -->
        <Image Grid.Row="1"
               Source="Image/cyberpal_logo.jpeg"
               Height="120"
               HorizontalAlignment="Center"
               Margin="0,10"
               Stretch="Uniform"/>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="Tasks"
                    Width="120"
                    Margin="5"
                    Click="Tasks_Click"/>

            <Button Content="Quiz"
                    Width="120"
                    Margin="5"
                    Click="Quiz_Click"/>

            <Button Content="Activity Log"
                    Width="120"
                    Margin="5"
                    Click="Log_Click"/>
        </StackPanel>

        <!-- CHAT AREA -->
        <RichTextBox Grid.Row="3"
                     Name="ChatBox"
                     Margin="0,10"
                     IsReadOnly="True"
                     FontSize="14"
                     Background="#000000"
                     Foreground="Lime"
                     BorderBrush="Cyan"
                     VerticalScrollBarVisibility="Auto"/>

        <!-- INPUT AREA -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,10">

            <TextBox Name="UserInput"
                     Width="700"
                     Height="40"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     Background="White"
                     Foreground="Black"
                     Margin="0,0,10,0"/>

            <Button Content="Send"
                    Width="150"
                    Height="40"
                    Background="Cyan"
                    Foreground="Black"
                    FontWeight="Bold"
                    Click="SendButton_Click"/>
        </StackPanel>

    </Grid>
</Window>

            